# Copy to .env for local development (never commit .env)
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:8000
# DATABASE_URL is set automatically by Heroku; leave unset locally to use SQLite
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://your-app.herokuapp.com

# --- shipping (fill in .env; never commit real keys) ---
FEDEX_ENV=sandbox
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
# FEDEX_ALCOHOL_SHIPPER_AGREEMENT=   # only if FedEx validation asks for it
UPS_ENV=sandbox
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
C7_APP_ID=
C7_APP_SECRET=
C7_TENANT_ID=
# Ship-from defaults to St. Amant Winery, 1 Winemaster Way, Lodi CA 95240; phone is required
SHIP_FROM_PHONE=
# SHIP_FROM_NAME=Shipping
# SHIP_FROM_EMAIL=
# Compliance gate: off = ship everything (2026); on = only C7 "Compliant" orders pool unless overridden
SHIP_COMPLIANCE_GATE=off
# SHIP_SYNC_LOOKBACK_DAYS=120
# SHIP_DEFAULT_CLUB_SKUS=23RTEMP,24SOUZ,24IRED,24TN
# Post tracking back to C7 (sends the ship email). Sandbox labels are never posted.
# SHIP_C7_WRITEBACK=on
# --- GLS US (wholesale orders from QBO). No GLS test server: sandbox = live API, test labels, no pickups ---
GLS_ENV=sandbox
GLS_ACCOUNT_NUMBER=
GLS_USERNAME=
GLS_PASSWORD=
# GLS_BASE_URL=https://ship.gls-us.com/v2
# GLS_PICKUP_EARLIEST=01:00 pm
# GLS_PICKUP_LATEST=05:00 pm
# GLS_PICKUP_INSTRUCTIONS=
# --- QuickBooks Online API app (developer.intuit.com); connect at /integrations/qbo/ ---
QBO_ENV=production
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:8000/integrations/qbo/callback/
# SHIP_QBO_GLS_SHIP_METHODS=GLS,GLS US,GSO
