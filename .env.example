# Copy to .env for local development (never commit .env)
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:8000
# DATABASE_URL is set automatically by Heroku; leave unset locally to use SQLite
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://your-app.herokuapp.com

# --- shipping (fill in .env; never commit real keys) ---
FEDEX_ENV=sandbox
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
# FEDEX_ALCOHOL_SHIPPER_AGREEMENT=   # only if FedEx validation asks for it
UPS_ENV=sandbox
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
C7_APP_ID=
C7_APP_SECRET=
C7_TENANT_ID=
# Ship-from defaults to St. Amant Winery, 1 Winemaster Way, Lodi CA 95240; phone is required
SHIP_FROM_PHONE=
# SHIP_FROM_NAME=Shipping
# SHIP_FROM_EMAIL=
# Compliance gate: off = ship everything (2026); on = only C7 "Compliant" orders pool unless overridden
SHIP_COMPLIANCE_GATE=off
# SHIP_SYNC_LOOKBACK_DAYS=120
# SHIP_DEFAULT_CLUB_SKUS=23RTEMP,24SOUZ,24IRED,24TN
